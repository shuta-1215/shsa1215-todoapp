.max-w-md.mx-auto.px-4.py-8
  %h1.text-3xl.font-bold.my-8.text-gray-900= @board.title

  .space-y-4
    - @board.tasks.each do |task|
      .bg-white.p-6.rounded-2xl.relative.shadow-sm
        %h2.text-lg.font-bold.text-gray-800.mb-2= task.title
        %p.text-sm.text-gray-500.leading-relaxed= task.content

        .flex.items-center.justify-between.mt-6
          .flex.-space-x-2
            %img.w-8.h-8.rounded-full.border-2.border-white{src: "https://i.pravatar.cc/150?u=#{task.user_id}"}
          .flex.items-center.text-gray-300.text-sm
            %span 23
            %i.far.fa-comment.ml-1

    = link_to new_board_task_path(@board), class: 'flex items-center justify-center w-full py-12 border-2 border-dashed border-gray-300 rounded-2xl text-gray-400 hover:bg-whit hover:border-blue-400 hover:text-blue-500 transition-all group mt-6' do
      %span.text-lg.font-medium + Add new card