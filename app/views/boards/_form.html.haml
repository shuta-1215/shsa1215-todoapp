= form_with model: board, local: true do |f|
  - if board.errors.any?
    .bg-red-50.border-l-4.border-red-400.p-4.mb-6.rounded-r-xl
      .flex
        .flex-shrink-0
          %i.fas.fa-exclamation-circle.text-red-400
        .ml-3
          %p.text-sm.text-red-700.font-bold
            #{board.errors.count} 件のエラーがあります
          %ul.mt-text-sm.text-red-600.lost-disc.list-inside
            - board.errors.full_messages.each do |message|
              %li= message
  .space-y-6
    %div
      = f.label :title, "Name", class: 'block text-lg font-medium text-gray-700 mb-2'
      = f.text_field :title, class: "w-full bg-gray-100 border-none rounded-xl p-4 focus:ring-2 #{board.errors[:title].any? ? 'ring-2 ring-red-400' : 'focus:ring-yellow-400'}"

    %div
      = f.label :content, "text", class: 'block text-lg font-medium text-gray-700 mb-2'
      = f.text_area :content, rows: 8, class: "w-full bg-gray-100 border-none rounded-xl p-4 focus:ring-2 #{board.errors[:content].any? ? 'ring-2 ring-red-400' : 'focus:ring-yellow-400'}"

    .pt-10
      = f.submit "保存", class: 'w-full bg-yellow-500 hover:bg-yellow-600 text-white font-bold py-4 rounded-xl shadow-lg transition-colors cursor-pointer'