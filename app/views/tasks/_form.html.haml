= form_with model: [@board, @task], local: true do |f|
  = render 'shared/error_messages', object: f.object

  .space-y-6
    %div
      = f.label :title, "Name", class: 'block text-lg font-medium text-gray-700 mb-2'
      = f.text_field :title, class: "w-full bg-gray-100 border-none rounded-xl p-4 focus:ring-2 focus:ring-yellow-400 #{f.object.errors[:title].any? ? 'ring-2 ring-red-400' : 'focus:ring-yellow-400'}"

    %div
      = f.label :content, "Description", class: 'block text-lg font-medium text-gray-700 mb-2'
      = f.text_area :content, rows: 8, class: "w-full bg-gray-100 border-none rounded-xl p-4 focus:ring-2 focus:ring-yellow-400"

    %div
      = f.label :deadline, "Deadline", class: 'block text-lg font-medium text-gray-700 mb-2'
      = f.date_field :deadline, class: "w-full bg-gray-100 border-none rounded-xl p-4 focus:ring-2 focus:ring-yellow-400"

    %div
      = f.label :eyecatch, "Eyecatch Image", class: 'block text-lg font-medium text-gray-700 mb-2'
      = f.file_field :eyecatch, accept: 'image/*', class: "w-full bg-gray-100 border-dashed border-2 boder-gray-300 rounded-xl p-8"

    .pt-10
      = f.submit "保存", class: 'w-full bg-yellow-500 hover:bg-yellow-600 text-white font-bold py-4 rounded-xl shadow-lg transition-colors cursor-pointer'