.max-w-md.mx-auto.px-4.py-8
  %h1.text-3xl.font-bold.my-8.text-gray-900= @board.title

  .space-y-4
    - @board.tasks.each do |task|
      = link_to board_task_path(@board, task), class: 'block' do
        .bg-white.rounded-2xl.relative.shadow-sm.overflow-hidden
          - if task.eyecatch.attached?
            .w-full.h-48.overflow-hidden.p-6
              = image_tag task.eyecatch, class: 'w-full h-full object-cover rounded-2xl'

          .p-6
            %h2.text-lg.font-bold.text-gray-800.mb-2= task.title
            %p.text-sm.text-gray-500.leading-relaxed= task.content

          .flex.items-center.justify-between.m-6
            .flex.-space-x-2
              %img.w-8.h-8.rounded-full.border-2.border-white{src: "https://i.pravatar.cc/150?u=#{task.user_id}"}
            - if task.deadline.present?
              - expired_class = task.deadline < Time.current ? 'text-red-500 font-bold' : 'text-gray-400'
              %div{ class: expired_class }
                = l task.deadline
            .flex.items-center.text-gray-300.text-sm
              - if task.comments.count > 0
                %span= task.comments.count
                %i.fas.fa-comment.ml-1.text-blue-300
              - else
                %i.fas.fa.comment.ml-1

    = link_to new_board_task_path(@board), class: 'flex items-center justify-center w-full py-12 mb-8 border-2 border-dashed border-gray-300 rounded-2xl text-gray-500 hover:bg-gray-50 hover:border-blue-400 hover:text-blue-500 transition-all group' do
      %span.text-lg.font-medium + Add new task