.max-w-2xl.mx-auto.px-6.py-8
  %h1.text-xl.font-bold.md-10.text-gray-900 New Comment

  = form_with model: [@task.board, @task, @comment], local: true do |f|
    .space-y-6
      %div
        = f.text_area :content, placeholder: "Enter comment...", rows: 12, class: "w-full bg-gray-100 border-none rounded-2xl p-6 focus:ring-2"

      .pt-10
        = f.submit "投稿", class: 'w-full bg-yellow-500 hover:bg-yellow-600 text-white font-bold py-4 rounded-xl shadow-lg transition-colors cursor-pointer'